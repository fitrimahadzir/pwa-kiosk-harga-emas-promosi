# Supabase (wajib — baca harga awam + Supabase Auth pentadbir).
# Salin ke .env.local dan isi dengan nilai dari
# Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Pilihan — hanya jika fungsi AI digunakan.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi ini dihoskan (untuk pautan kendiri).
APP_URL="MY_APP_URL"

# Nota keselamatan:
#   - JANGAN letak service_role key dalam fail ini atau mana-mana kod klien.
#   - Kiosk/outlet hanya membaca. Penulisan harga memerlukan pengguna
#     Supabase Auth yang didaftarkan dalam public.kiosk_admins.
#   - Jalankan supabase/schema.sql dalam SQL Editor sebelum digunakan.
